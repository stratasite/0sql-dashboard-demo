# ---------------------------------------------------------------- 0sql
# A read-only query key from https://app.0sql.io, granted the project below.
# Personal keys (zsk_…) work too, but a query key is what an application
# should carry: it can plan and discover, and nothing else.
ZSQL_QUERY_KEY=zqk_...

# Where the project is deployed. These are the defaults; change them if you
# deployed under a different uid or branch.
ZSQL_PROJECT=customer-service
ZSQL_BRANCH=main
ZSQL_API_BASE=https://app.0sql.io

# ---------------------------------------------------------------- model
# The chat agent. Either provider drives it: a query spec is JSON against a
# published schema, so any model that can call a function can write one.
# Set one key, or set both and pick with LLM_PROVIDER (anthropic | openai).
# With neither set the app says so instead of failing mid-answer.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# LLM_PROVIDER=anthropic

# Optional model overrides. Defaults: claude-opus-5 and gpt-5.1.
# ANTHROPIC_MODEL=claude-opus-5
# OPENAI_MODEL=gpt-5.1

# ------------------------------------------------------------ warehouse
# The DuckDB file `npm run seed` builds. 0sql never reads this; the app does.
DUCKDB_PATH=warehouse/cs_warehouse.duckdb

# Where pinned tiles are stored. Delete the file to get the starter dashboard
# back.
TILES_PATH=data/tiles.json
